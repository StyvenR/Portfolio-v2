// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([email])
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  image       String?
  tags        String[]
  link        String?
  github      String?
  order       Int      @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  competences ProjectCompetence[]

  @@index([order])
}

/// Lien projet <-> compétence du référentiel. Le référentiel lui-même
/// (activités A1-A7, blocs C1/C2/C3) vit dans utils/competences.ts :
/// `code` référence une compétence de ALL_COMPETENCES, ex. "C2.4".
model ProjectCompetence {
  id        String   @id @default(cuid())
  projectId String
  code      String
  evidence  String?  @db.Text
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, code])
  @@index([code])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}
