# =============================================================================
# Portfolio v2 — modèle de configuration
#
# Copiez ce fichier en `.env.local` puis remplissez les valeurs :
#     cp .env.example .env.local
#
# Précédence : `.env.local` est prioritaire sur `.env`, pour Next.js comme pour
# le CLI Prisma (voir prisma.config.ts). Ne commitez jamais vos vrais secrets.
# =============================================================================

# --- Base de données (requis) -------------------------------------------------
# Connexion PostgreSQL utilisée par l'application au runtime (pooled).
DATABASE_URL="postgresql://user:password@localhost:5432/portfolio"

# Connexion directe (non poolée) utilisée par le CLI Prisma pour les migrations.
# Avec un pooler (Supabase, Neon, PgBouncer), pointez-la sur le port direct.
# En local sans pooler, reprenez simplement la même valeur que DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/portfolio"

# --- Authentification (requis) ------------------------------------------------
# Secret de signature des JWT du back-office (validité 7 jours).
# Générer une valeur solide :  openssl rand -base64 32
JWT_SECRET="remplacez-par-une-chaine-aleatoire-longue"

# Utilisé en repli par lib/jwt.ts si JWT_SECRET est absent.
NEXTAUTH_SECRET="remplacez-par-une-chaine-aleatoire-longue"

# --- URLs (optionnel) ---------------------------------------------------------
# URL publique du site : metadata SEO, Open Graph, sitemap.xml, robots.txt.
# Défaut si absent : http://localhost:3000
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# URL de base de l'application.
NEXTAUTH_URL="http://localhost:3000"

# --- Comptes créés par le seed (optionnel) ------------------------------------
# Utilisés uniquement par `pnpm db:seed`. Si le couple est absent, le compte
# n'est pas créé. Le mot de passe est haché en bcrypt avant insertion.

# Compte administrateur : accès complet en lecture et écriture.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="remplacez-par-un-mot-de-passe-solide"

# Compte de démonstration en lecture seule (rôle `visitor_admin`) : accède au
# back-office mais reçoit un 403 sur toute route d'écriture.
VISITOR_ADMIN_EMAIL="demo@example.com"
VISITOR_ADMIN_PASSWORD="remplacez-par-un-mot-de-passe-solide"

# --- Stockage des images (optionnel) ------------------------------------------
# Token Vercel Blob, requis uniquement pour l'upload d'images de projets
# (POST /api/admin/projects/upload). Récupérable via `vercel env pull` ou
# depuis l'onglet Storage du projet Vercel.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"
